---
import BlogLayout from '../../layouts/BlogLayout.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const posts: CollectionEntry<'blog'>[] = await getCollection('blog')
const reversedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<BlogLayout
  title="Desde la Capa de Dominio — Arquitectura y software de calidad"
  description="Un blog técnico sobre DDD, clean architecture, diseño de sistemas y experiencias reales en proyectos de software. Por Abraham Vilches."
>
  <main class="space-y-10">
    <!-- Hero principal -->
    <section class="space-y-4 text-center">
      <h1
        class="bg-gradient-to-r from-indigo-400 via-purple-500 to-indigo-400 bg-clip-text text-5xl leading-tight font-extrabold text-transparent"
      >
        Desde la Capa de Dominio
      </h1>
      <p class="mx-auto max-w-xl text-lg text-white/70">
        Arquitectura de software, diseño intencional y desarrollo sostenible.
        Por <a
          href="https://abrahamvilches.com"
          class="text-indigo-400">Abraham Vilches</a
        >.
      </p>
    </section>

    <!-- Últimos artículos -->
    <section class="space-y-6">
      <h2 class="text-2xl font-semibold">📚 Últimos artículos</h2>
      <ul class="space-y-4">
        {
          reversedPosts.map((post) => (
            <li class="border-b border-white/10 pb-4">
              <a
                href={`/blog/${post.id}/`}
                class="text-xl font-semibold text-indigo-400 hover:underline"
              >
                {post.data.title}
              </a>
              <p class="text-sm text-white/60">{post.data.description}</p>
              <time class="text-xs text-white/40">
                {post.data.pubDate.toLocaleDateString('es-ES')}
              </time>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BlogLayout>
