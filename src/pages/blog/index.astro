---
import BlogLayout from '../../layouts/BlogLayout.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const posts: CollectionEntry<'blog'>[] = await getCollection('blog')
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<BlogLayout
  title="Desde la Capa de Dominio — Arquitectura y software de calidad"
  description="Un blog técnico sobre DDD, clean architecture, diseño de sistemas y experiencias reales en proyectos de software. Por Abraham Vilches."
>
  <main class="space-y-12">

    <!-- Hero minimalista -->
    <section class="space-y-2">
      <h1 class="font-mono text-3xl font-semibold text-indigo-400">
        Desde la Capa de Dominio
      </h1>
      <p class="text-white/50 text-sm">
        Diseño estratégico, arquitectura y decisiones técnicas que importan.
      </p>
    </section>

    <!-- Todos los artículos -->
    <section class="space-y-6">
      <ul class="space-y-6">
        {
          sortedPosts.map((post) => (
            <li class="border-b border-white/10 pb-6">
              <a
                href={`/blog/${post.id}/`}
                class="text-lg font-semibold text-indigo-400 hover:underline"
              >
                {post.data.title}
              </a>
              <p class="mt-1 text-sm text-white/60">{post.data.description}</p>
              <div class="mt-2 flex flex-wrap items-center gap-4">
                <time class="font-mono text-xs text-white/40">
                  {post.data.pubDate.toLocaleDateString('es-ES')}
                </time>
                {post.data.tags &&
                  post.data.tags.map((tag) => (
                    <span class="font-mono text-xs border border-indigo-400/30 text-indigo-400 px-2 py-0.5 rounded">
                      {tag}
                    </span>
                  ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

  </main>
</BlogLayout>
