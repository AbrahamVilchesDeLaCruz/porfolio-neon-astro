---
import BlogLayout from '../../layouts/BlogLayout.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { post: entry },
  }))
}

const { post }: { post: CollectionEntry<'blog'> } = Astro.props
const { Content } = await render(post)
const data = post.data
---

<BlogLayout
  title={data.title}
  description={data.description}
  header="Desde La Capa De Dominio"
  headerRef="/blog"
>
  <article class="prose prose-neon mx-auto w-full max-w-3xl px-0">
    <a href="/blog" class="text-sm text-white/40 hover:text-indigo-400 no-underline">← Volver al blog</a>

    <h1 class="mb-2 mt-6 text-2xl sm:text-4xl font-bold text-indigo-400 text-left">{data.title}</h1>
    <p class="mb-4 text-white/60 italic">{data.description}</p>
    <div class="mb-6 flex flex-wrap gap-4 items-center">
      <time class="font-mono text-xs text-white/40">
        {data.pubDate.toLocaleDateString('es-ES')}
      </time>
      {
        data.tags &&
          data.tags.map((tag) => (
            <span class="font-mono text-xs border border-indigo-400/30 text-indigo-400 px-2 py-0.5 rounded">
              {tag}
            </span>
          ))
      }
    </div>
    <hr style="margin:2rem 0; border:none; border-top:1px solid rgba(255,255,255,0.1);" />

    <Content />
  </article>
</BlogLayout>
