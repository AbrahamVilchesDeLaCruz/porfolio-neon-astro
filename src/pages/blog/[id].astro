---
import BlogLayout from '../../layouts/BlogLayout.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { post: entry },
  }))
}

const { post }: { post: CollectionEntry<'blog'> } = Astro.props
const { Content } = await render(post)
const data = post.data
---

<BlogLayout
  title={data.title}
  description={data.description}
  header="Desde La Capa De Dominio"
  headerRef="/blog"
>
  <article class="prose prose-slate dark:prose-invert mx-auto max-w-3xl px-4">
    {
      data.image && (
        <img
          src={data.image}
          alt={data.title}
          class="mx-auto h-28 w-40 rounded-lg mt-4 object-cover"
        />
      )
    }
    <h1 class="mb-2 text-4xl font-bold text-indigo-400 text-center mt-6">{data.title}</h1>
    <p class="mb-4 text-slate-500">{data.description}</p>
    <time class="mb-6 block text-xs text-slate-400">
      {data.pubDate.toLocaleDateString()}
    </time>
    <div class="flex flex-wrap items-center justify-center gap-2 w-full">
      {
        data.tags &&
          data.tags.map((tag) => (
            <span class="mr-2 inline-block rounded-full bg-indigo-400 px-3 py-1 text-xs font-semibold text-indigo-900">
              {tag}
            </span>
          ))
      }
    </div>
    <hr style="margin:2rem 0; border:none; border-top:1px solid #CBD5E1;" />

    <Content />
  </article>
</BlogLayout>
