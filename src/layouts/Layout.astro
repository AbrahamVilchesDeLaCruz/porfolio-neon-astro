---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import BackToTop from '../components/BackToTop.astro'
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/IMG_0232.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<link
		href="https://fonts.googleapis.com/css2?family=Cascadia+Code:ital,wght@0,200..700;1,200..700&display=swap"
		rel="stylesheet"
	  />
		<title>Abraham Vilches de la Cruz</title>
	</head>
	<body class="bg-black text-white min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-grow">
		  <slot />
		</main>
		<BackToTop />
	</body>

</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	main::-webkit-scrollbar {
    width: 8px;
  }
  main::-webkit-scrollbar-track {
    background: #1c478c;
  }
  main::-webkit-scrollbar-thumb {
    background-color: #217bef;
    border-radius: 10px;
    border: 2px solid #1c478c;
  }
  main {
    scrollbar-width: thin;
    scrollbar-color: #217bef #1c478c;
  }
</style>
