---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import BackToTop from '../components/BackToTop.astro'

interface Props {
  title?: string
  description?: string
  canonical?: string
}

const {
  title = 'Abraham Vilches — Ingeniero de Software | DDD & Arquitecturas Limpias',
  description = 'Ingeniero de Software especializado en DDD, arquitecturas limpias y microservicios. Ayudo a equipos a reducir complejidad técnica sin sacrificar velocidad de producto.',
  canonical = 'https://abrahamvilches.com',
} = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/IMG_0232.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<link
		href="https://fonts.googleapis.com/css2?family=Cascadia+Code:ital,wght@0,200..700;1,200..700&display=swap"
		rel="stylesheet"
	  />
		<title>{title}</title>

		<!-- SEO -->
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:title" content="Abraham Vilches — Ingeniero de Software | DDD & Arquitecturas Limpias" />
		<meta property="og:description" content="Ingeniero de Software especializado en DDD, arquitecturas limpias y microservicios. Ayudo a equipos a reducir complejidad técnica sin sacrificar velocidad de producto." />
		<meta property="og:image" content="https://abrahamvilches.com/IMG_0230.jpeg" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://abrahamvilches.com" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Abraham Vilches — Ingeniero de Software | DDD & Arquitecturas Limpias" />
		<meta name="twitter:description" content="Ingeniero de Software especializado en DDD, arquitecturas limpias y microservicios. Ayudo a equipos a reducir complejidad técnica sin sacrificar velocidad de producto." />
		<meta name="twitter:image" content="https://abrahamvilches.com/IMG_0230.jpeg" />

		<!-- Schema markup: Person -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Abraham Vilches de la Cruz",
			"jobTitle": "Ingeniero de Software",
			"url": "https://abrahamvilches.com",
			"image": "https://abrahamvilches.com/IMG_0230.jpeg",
			"sameAs": [
				"https://github.com/AbrahamVilchesDeLaCruz",
				"https://www.linkedin.com/in/abraham-vilches-de-la-cruz-295538175/",
				"/blog"
			],
			"knowsAbout": ["Domain-Driven Design", "Clean Architecture", "Microservicios", "React", "Node.js", "TypeScript", "Event-Driven Architecture"]
		}
		</script>
	</head>
	<body class="bg-black text-white min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-grow">
		  <slot />
		</main>
		<BackToTop />
		<script>
		  document.addEventListener('click', (e) => {
		    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-toggle-tags] button');
		    if (!btn) return;

		    const list = btn.closest('ul');
		    if (!list) return;

		    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
		    const extraItems = list.querySelectorAll<HTMLLIElement>('li[data-extra="true"]');
		    const count = Number(btn.dataset.count);

		    extraItems.forEach((item) => {
		      item.classList.toggle('hidden', isExpanded);
		    });

		    btn.setAttribute('aria-expanded', String(!isExpanded));
		    btn.textContent = isExpanded ? `+${count} más` : 'Ver menos';
		  });
		</script>
	</body>

</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	main::-webkit-scrollbar {
    width: 8px;
  }
  main::-webkit-scrollbar-track {
    background: #312e81;
  }
  main::-webkit-scrollbar-thumb {
    background-color: #818cf8;
    border-radius: 10px;
    border: 2px solid #312e81;
  }
  main {
    scrollbar-width: thin;
    scrollbar-color: #818cf8 #312e81;
  }
</style>
