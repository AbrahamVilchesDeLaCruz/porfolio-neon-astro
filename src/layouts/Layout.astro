---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import BackToTop from '../components/BackToTop.astro'
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/IMG_0232.jpeg" />
		<meta name="generator" content={Astro.generator} />
		<link
		href="https://fonts.googleapis.com/css2?family=Cascadia+Code:ital,wght@0,200..700;1,200..700&display=swap"
		rel="stylesheet"
	  />
		<title>Abraham Vilches — Ingeniero de Software | DDD & Arquitecturas Limpias</title>

		<!-- SEO -->
		<meta name="description" content="Ingeniero de Software especializado en DDD, arquitecturas limpias y microservicios. Ayudo a equipos a reducir complejidad técnica sin sacrificar velocidad de producto." />
		<link rel="canonical" href="https://abrahamvilches.com" />

		<!-- Open Graph -->
		<meta property="og:title" content="Abraham Vilches — Ingeniero de Software | DDD & Arquitecturas Limpias" />
		<meta property="og:description" content="Ingeniero de Software especializado en DDD, arquitecturas limpias y microservicios. Ayudo a equipos a reducir complejidad técnica sin sacrificar velocidad de producto." />
		<meta property="og:image" content="https://abrahamvilches.com/IMG_0230.jpeg" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://abrahamvilches.com" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Abraham Vilches — Ingeniero de Software | DDD & Arquitecturas Limpias" />
		<meta name="twitter:description" content="Ingeniero de Software especializado en DDD, arquitecturas limpias y microservicios. Ayudo a equipos a reducir complejidad técnica sin sacrificar velocidad de producto." />
		<meta name="twitter:image" content="https://abrahamvilches.com/IMG_0230.jpeg" />

		<!-- Schema markup: Person -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Abraham Vilches de la Cruz",
			"jobTitle": "Ingeniero de Software",
			"url": "https://abrahamvilches.com",
			"image": "https://abrahamvilches.com/IMG_0230.jpeg",
			"sameAs": [
				"https://github.com/AbrahamVilchesDeLaCruz",
				"https://www.linkedin.com/in/abraham-vilches-de-la-cruz-295538175/",
				"https://dddominio.com"
			],
			"knowsAbout": ["Domain-Driven Design", "Clean Architecture", "Microservicios", "React", "Node.js", "TypeScript", "Event-Driven Architecture"]
		}
		</script>
	</head>
	<body class="bg-black text-white min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-grow">
		  <slot />
		</main>
		<BackToTop />
	</body>

</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	main::-webkit-scrollbar {
    width: 8px;
  }
  main::-webkit-scrollbar-track {
    background: #1c478c;
  }
  main::-webkit-scrollbar-thumb {
    background-color: #217bef;
    border-radius: 10px;
    border: 2px solid #1c478c;
  }
  main {
    scrollbar-width: thin;
    scrollbar-color: #217bef #1c478c;
  }
</style>
