---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  header?: string
  headerRef?: string
}

const {
  title = 'Desde la Capa de Dominio',
  description = 'Blog técnico sobre arquitectura de software, diseño intencional y desarrollo sostenible.',
  header = 'DDDominio',
  headerRef = '/blog',
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Abraham Vilches de la Cruz" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="icon" type="image/jpeg" href="/IMG_0232.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cascadia+Code:ital,wght@0,200..700;1,200..700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="flex min-h-screen flex-col bg-black text-white">
    <!-- Header fijo -->
    <header
      class="fixed top-0 z-50 flex w-full items-center justify-between border-b border-white/10 bg-black px-6 py-4 text-sm text-white/50 backdrop-blur"
    >
      <a
        href={headerRef}
        class="text-lg font-semibold text-indigo-400 hover:text-white"
      >{header}</a>
      <nav class="space-x-4">
        <a href="/blog" class="hover:text-white">Blog</a>
        <a
          href="https://www.linkedin.com/in/abraham-vilches-de-la-cruz-295538175/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white">LinkedIn</a
        >
        <a
          href="https://github.com/AbrahamVilchesDeLaCruz"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white">GitHub</a
        >
      </nav>
    </header>

    <!-- Contenido -->
    <main class="mx-auto max-w-3xl flex-1 px-4 py-10 pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="flex flex-col gap-4 border-t border-white/10 px-4 py-6 text-center text-sm text-white/50"
    >
      <a
        href="https://ko-fi.com/desdelacapadedominio"
        target="_blank"
        rel="noopener noreferrer"
        class="w-fit self-center text-indigo-400 transition hover:text-white"
      >
        ☕ ¿Nos tomamos un café? ☕
      </a>
      © {new Date().getFullYear()} Abraham Vilches — Construyendo desde la capa de dominio.
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
  }

  html::-webkit-scrollbar {
    width: 8px;
  }
  html::-webkit-scrollbar-track {
    background: #1f2937;
  }
  html::-webkit-scrollbar-thumb {
    background-color: #4f46e5;
    border-radius: 10px;
    border: 2px solid #1f2937;
  }

  html {
    scrollbar-width: thin;
    scrollbar-color: #4f46e5 #1f2937;
  }
</style>
