---
import SectionTitle from './SectionTitle.astro';
import { trainingData } from './training/data/training';
---
<section class="py-20" aria-label="Training and Education Section">
  <div class="px-4">
    <SectionTitle title="Formación" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-xs md:max-w-3xl lg:max-w-7xl mx-auto">
      {trainingData.map(item => (
        <div
          class="w-full rounded-xl border border-mariner-600 hover:border-mariner-400 hover:shadow-neon transition-all duration-300 overflow-hidden flex flex-col bg-mariner-950/40"
          role="article"
        >
          {/* Logo institución */}
          <div class="h-28 overflow-hidden flex items-center justify-center border-b border-mariner-700 bg-mariner-950 p-4">
            <img
              src={item.image}
              alt={`Logo de ${item.institution}`}
              loading="lazy"
              class="object-contain max-h-full max-w-full"
            />
          </div>

          {/* Contenido */}
          <div class="p-5 flex flex-col flex-grow gap-3">
            <div>
              <h3 class="text-base font-bold text-mariner-100 mb-0.5">{item.title}</h3>
              <p class="text-sm font-medium text-mariner-300">{item.institution}</p>
              <p class="text-xs text-mariner-500">{item.duration}</p>
            </div>

            <p class="text-sm text-white/80 leading-relaxed flex-grow">{item.summary}</p>

            {/* Tags de tecnologías — máximo 6, sin interacción */}
            {item.technologies && item.technologies.length > 0 && (
              <ul class="flex flex-wrap gap-1.5 pt-2 border-t border-mariner-800" role="list" aria-label={`Tecnologías de ${item.title}`}>
                {item.technologies.slice(0, 6).map((tech: string) => (
                  <li>
                    <span class="text-xs bg-mariner-800/60 text-mariner-300 px-2 py-0.5 rounded-md border border-mariner-700 font-medium">
                      {tech}
                    </span>
                  </li>
                ))}
                {item.technologies.length > 6 && (
                  <li>
                    <span class="text-xs text-mariner-500 px-1 font-medium">
                      +{item.technologies.length - 6} más
                    </span>
                  </li>
                )}
              </ul>
            )}
          </div>

          {/* CTA */}
          <div class="px-5 pb-5">
            <a
              class="w-full py-2 px-4 bg-mariner-700/60 text-mariner-100 text-sm rounded-md hover:bg-mariner-600 border border-mariner-600 transition-colors duration-200 block text-center"
              aria-label={`Más información sobre ${item.title}`}
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              Más información
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
