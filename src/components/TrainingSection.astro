---
import SectionTitle from './SectionTitle.astro';
import { trainingData } from './training/data/training';

const peakSkills = [
  ['C++', 'Java', 'Estructuras de Datos', 'Algoritmos'],
  ['React', 'TypeScript', 'Testing', 'Angular'],
  ['DDD', 'Arquitectura Hexagonal', 'TDD', 'Clean Code'],
  ['IA', 'LLMs', 'Agentes', 'Automatización'],
];

// Peak X positions as percentages matching the overlay peak markers
const peakPositions = [18, 41.3, 64.7, 88];
---

<section class="py-20 relative overflow-hidden" aria-label="Training and Education Section">
  <div class="px-4">
    <SectionTitle title="Formación" />

    <!-- ============================================================ -->
    <!-- DESKTOP: Mountain Timeline (lg+)                              -->
    <!-- ============================================================ -->
    <div class="hidden lg:block relative mx-auto w-full" style="max-width: 1400px; aspect-ratio: 5 / 2;">
      <!-- SVG Mountain range (fills the container) -->
      <svg
        class="absolute inset-0 w-full h-full pointer-events-none select-none"
        viewBox="0 0 1200 480"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="mt-front" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="#818cf8" stop-opacity="0.14" />
            <stop offset="60%" stop-color="#818cf8" stop-opacity="0.04" />
            <stop offset="100%" stop-color="#818cf8" stop-opacity="0.01" />
          </linearGradient>
          <linearGradient id="mt-back" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="#818cf8" stop-opacity="0.06" />
            <stop offset="100%" stop-color="#818cf8" stop-opacity="0.015" />
          </linearGradient>
          <linearGradient id="mt-mid" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="#818cf8" stop-opacity="0.09" />
            <stop offset="100%" stop-color="#818cf8" stop-opacity="0.025" />
          </linearGradient>
          <filter id="peak-glow">
            <feDropShadow dx="0" dy="0" stdDeviation="5" flood-color="#818cf8" flood-opacity="0.5"/>
          </filter>
        </defs>

        <!-- Background range (scaled to viewBox 1200×480) -->
        <polygon points="0,480 60,384 140,408 220,336 300,368 380,288 460,320 540,248 620,280 700,208 780,240 860,168 940,208 1020,152 1100,184 1200,136 1200,480" fill="url(#mt-back)" />
        <polyline points="0,384 140,408 220,336 380,288 540,248 700,208 860,168 1020,152 1200,136" fill="none" stroke="#818cf8" stroke-width="1" opacity="0.08" />
        <!-- Middle range -->
        <polygon points="0,480 80,400 160,424 250,352 340,376 430,304 520,336 610,264 700,296 790,224 880,256 970,184 1060,216 1150,160 1200,176 1200,480" fill="url(#mt-mid)" />
        <polyline points="0,400 160,424 250,352 430,304 610,264 790,224 970,184 1200,176" fill="none" stroke="#818cf8" stroke-width="1" opacity="0.12" />
        <!-- Front range — 4 peaks (shifted to align with overlay: 216/444/672/912) -->
        <polygon points="0,480 60,424 140,392 216,304 276,352 383,320 496,224 582,288 678,256 776,152 866,224 969,192 1056,96 1096,200 1146,230 1176,224 1200,240 1200,480" fill="url(#mt-front)" />
        <polyline points="0,424 140,392 216,304 383,320 496,224 678,256 776,152 969,192 1056,96 1146,184 1200,240" fill="none" stroke="#818cf8" stroke-width="1.5" opacity="0.25" />

        <!-- Diagonal lines from peak to card left side -->
        <!-- P1: (216,304) → card right edge (204, 304-24) -->
        <line x1="216" y1="304" x2="204" y2="280" stroke="#818cf8" stroke-width="1.5" opacity="0.5" />
        <!-- P2: (496,224) → card right edge (460, 224-14) -->
        <line x1="496" y1="224" x2="460" y2="210" stroke="#818cf8" stroke-width="1.5" opacity="0.5" />
        <!-- P3: (776,152) → card right edge (740, 152-10) -->
        <line x1="776" y1="152" x2="740" y2="142" stroke="#818cf8" stroke-width="1.5" opacity="0.5" />
        <!-- P4: (1056,96) → card right edge (1020, 96+14) -->
        <line x1="1056" y1="96" x2="1020" y2="110" stroke="#818cf8" stroke-width="1.5" opacity="0.5" />

        <!-- Peak dots -->
        <circle cx="216" cy="304" r="20" fill="#818cf8" opacity="0.08" />
        <circle cx="216" cy="304" r="7" fill="#a5b4fc" opacity="0.9" filter="url(#peak-glow)" />
        <circle cx="496" cy="224" r="20" fill="#818cf8" opacity="0.08" />
        <circle cx="496" cy="224" r="7" fill="#a5b4fc" opacity="0.9" filter="url(#peak-glow)" />
        <circle cx="776" cy="152" r="20" fill="#818cf8" opacity="0.08" />
        <circle cx="776" cy="152" r="7" fill="#a5b4fc" opacity="0.9" filter="url(#peak-glow)" />
        <circle cx="1056" cy="96" r="22" fill="#818cf8" opacity="0.12" />
        <circle cx="1056" cy="96" r="8" fill="#a5b4fc" opacity="0.95" filter="url(#peak-glow)" />
      </svg>

      <!-- Peak markers — z-20, above cards -->
      <div class="absolute inset-0 z-20 pointer-events-none">
        {[{ x: 18, y: 63.3 }, { x: 41.3, y: 46.7 }, { x: 64.7, y: 31.7 }, { x: 88, y: 20 }].map((pos) => (
          <div
            style={`position: absolute; left: ${pos.x}%; top: ${pos.y}%; transform: translate(-50%, -50%);`}
            class="w-5 h-5 rounded-full bg-indigo-400 ring-2 ring-indigo-300/60 shadow-lg shadow-indigo-400/50 pointer-events-auto"
            aria-hidden="true"
          />
        ))}
      </div>

      <!-- Cards — z-10, left of peaks -->
      <div class="absolute inset-0 z-10 pointer-events-none">
        {
          [
            { x: 18,  y: 63.3, yOff: -5 },
            { x: 41.3, y: 46.7, yOff: -3 },
            { x: 64.7, y: 31.7, yOff: -2 },
            { x: 88,  y: 20,   yOff: 3   },
          ].map((pos, idx) => {
            const item = trainingData[idx];
            const skills = peakSkills[idx] ?? item.technologies.slice(0, 4);

            return (
              <div
                style={`position: absolute; top: calc(${pos.y}% + ${pos.yOff}%); left: max(0%, calc(${pos.x}% - 20%)); width: 17%; transform: translateY(-50%);`}
                class="pointer-events-auto"
              >
                <div class="rounded-xl border border-indigo-600/50 hover:border-indigo-400 transition-all duration-200 bg-black/70 backdrop-blur-md p-3 shadow-lg shadow-indigo-950/30">
                  <div class="flex items-start gap-2">
                    <div class="w-9 h-9 shrink-0 rounded-lg overflow-hidden bg-indigo-950/80 border border-indigo-800/50 flex items-center justify-center p-1.5">
                      <img src={item.image} alt="" loading="lazy" class="object-contain max-w-full max-h-full" />
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-base font-bold text-indigo-100 leading-tight">{item.title}</h3>
                      <p class="text-sm text-indigo-300 mt-0.5">{item.institution}</p>
                      <span class="inline-block mt-1.5 text-xs font-mono text-indigo-400/50 bg-indigo-950/40 px-1.5 py-0.5 rounded border border-indigo-800/30">{item.duration}</span>
                    </div>
                  </div>

                  <p class="mt-2 text-sm text-white/70 leading-relaxed line-clamp-2">{item.summary}</p>

                  <div class="mt-1.5 flex flex-wrap gap-1">
                    {skills.map((skill: string) => (
                      <span class="text-xs bg-indigo-800/40 text-indigo-300 px-2 py-0.5 rounded-md border border-indigo-700/40 font-medium">{skill}</span>
                    ))}
                  </div>

                  <div class="mt-2 pt-1.5 border-t border-indigo-800/30">
                    <a href={item.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-medium text-indigo-400 hover:text-indigo-200 transition-colors">
                      Saber más
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- TABLET / MOBILE: Compact vertical list                       -->
    <!-- ============================================================ -->
    <div class="lg:hidden max-w-2xl mx-auto">
      <div class="relative pl-8 border-l-2 border-indigo-800/50 space-y-10">
        {
          trainingData.map((item, idx) => {
            const skills = peakSkills[idx] ?? item.technologies.slice(0, 4);

            return (
              <div class="relative">
                {/* Marker dot */}
                <div class="absolute -left-[calc(2rem+5px)] top-1.5 w-3 h-3 rounded-full bg-indigo-400 ring-[5px] ring-black" />

                <div
                  class="rounded-xl border border-indigo-600/60 hover:border-indigo-400 transition-all duration-300 bg-indigo-950/40 overflow-hidden"
                  role="article"
                >
                  {/* Header */}
                  <div class="flex items-start gap-3 p-4 pb-2">
                    <div class="w-10 h-10 shrink-0 rounded-lg overflow-hidden bg-indigo-950/80 border border-indigo-800/50 flex items-center justify-center p-1.5">
                      <img
                        src={item.image}
                        alt={`Logo de ${item.institution}`}
                        loading="lazy"
                        class="object-contain max-w-full max-h-full"
                      />
                    </div>
                    <div class="min-w-0">
                      <h3 class="text-sm font-bold text-indigo-100 leading-tight">{item.title}</h3>
                      <p class="text-xs text-indigo-300 mt-0.5">{item.institution}</p>
                      <span class="inline-block mt-1 text-[10px] font-mono text-indigo-400/60 bg-indigo-950/60 px-1.5 py-0.5 rounded border border-indigo-800/40">
                        {item.duration}
                      </span>
                    </div>
                  </div>

                  <p class="px-4 pb-2 text-xs text-white/70 leading-relaxed line-clamp-2">{item.summary}</p>

                  <div class="px-4 pb-3">
                    <div class="flex flex-wrap gap-1">
                      {skills.map((skill: string) => (
                        <span class="text-[10px] bg-indigo-800/50 text-indigo-300 px-1.5 py-0.5 rounded-md border border-indigo-700/50 font-medium">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="px-4 pb-4">
                    <a
                      class="inline-flex items-center gap-1 text-xs font-medium text-indigo-400 hover:text-indigo-200 transition-colors"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Saber más
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17l9.2-9.2M17 17V7H7"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
