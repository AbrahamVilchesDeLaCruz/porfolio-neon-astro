<style>
  .nav-link.active {
    color: #5db8fd;
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: #5db8fd;
    box-shadow: 0 0 6px #5db8fd, 0 0 12px #3799fa;
    border-radius: 2px;
  }
  .nav-icon.active {
    color: #5db8fd;
    filter: drop-shadow(0 0 4px #5db8fd);
  }
</style>

<script>
  const sections = ['hero', 'experience', 'projects', 'training', 'books', 'contact'];

  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('#navbar-desktop .nav-link');
  const mobileIcons  = document.querySelectorAll<HTMLAnchorElement>('#navbar-mobile .nav-icon');

  function setActive(id: string) {
    desktopLinks.forEach(el => {
      el.classList.toggle('active', el.dataset.section === id);
    });
    mobileIcons.forEach(el => {
      el.classList.toggle('active', el.dataset.section === id);
    });
  }

  const observers = sections.map(id => {
    const el = document.getElementById(id);
    if (!el) return null;
    const obs = new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) setActive(id); },
      { threshold: 0.3 }
    );
    obs.observe(el);
    return obs;
  });

  // Activar hero por defecto
  setActive('hero');
</script>
