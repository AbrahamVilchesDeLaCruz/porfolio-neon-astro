---
import Stiker from './hero/Stiker.astro';
import Presentation from './hero/Presentation.astro';
import Buttons from './hero/Buttons.astro';
import SocialMedia from './hero/SocialMedia.astro';
import ScrollDown from './hero/ScrollDown.astro';
---
<section class="relative flex-1 flex items-center justify-center overflow-hidden px-4 sm:px-6 md:px-8">
  <div class="relative z-10 w-full max-w-7xl flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">

    {/* Columna izquierda: foto + botones + social — en mobile van arriba, en desktop a la izquierda */}
    <div class="flex flex-col items-center justify-center w-full md:w-2/5 gap-6 md:gap-10 md:h-full">
      <Stiker />
      <Buttons />
      <SocialMedia />
    </div>

    {/* Columna derecha: presentación — en mobile va abajo, en desktop a la derecha */}
    <div class="flex flex-col items-center md:items-start justify-center text-center md:text-left w-full md:w-3/5 md:h-full">
      <Presentation />
    </div>

  </div>
  <div class="absolute bottom-6 sm:bottom-8 left-1/2 transform -translate-x-1/2 z-50 pointer-events-none hidden sm:block">
    <div class="pointer-events-auto">
      <ScrollDown />
    </div>
  </div>
</section>
