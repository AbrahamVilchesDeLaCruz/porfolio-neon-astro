---
import Stiker from './hero/Stiker.astro';
import Presentation from './hero/Presentation.astro';
import Buttons from './hero/Buttons.astro';
import SocialMedia from './hero/SocialMedia.astro';
import ScrollDown from './hero/ScrollDown.astro';
---
<section class="relative flex flex-col items-center justify-center overflow-hidden px-4 sm:px-6 md:px-8 min-h-[calc(100dvh-3.5rem)] pt-4 pb-12">
  <div class="relative z-10 w-full max-w-7xl flex flex-col items-center gap-8">

    <!-- Mobile: orden vertical -->
    <div class="flex flex-col items-center justify-center w-full gap-6 md:hidden">
      <Stiker />
      <Presentation />
      <Buttons />
      <SocialMedia />
    </div>

    <!-- Desktop: dos columnas + botones abajo -->
    <div class="hidden md:flex flex-col items-center w-full gap-8">
      <!-- Fila superior: foto | bio -->
      <div class="flex flex-row items-center justify-center w-full gap-16">
        <!-- Izquierda: foto + social -->
        <div class="flex flex-col items-center justify-center gap-8 w-2/5">
          <Stiker />
          <SocialMedia />
        </div>
        <!-- Derecha: presentación -->
        <div class="flex flex-col items-start justify-center text-left w-3/5">
          <Presentation />
        </div>
      </div>
      <!-- Fila inferior: botones centrados -->
      <div class="flex justify-center w-full">
        <Buttons />
      </div>
    </div>

  </div>

  <!-- ScrollDown: siempre visible -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-50">
    <ScrollDown />
  </div>
</section>
