---
const btnPrimary = "flex items-center justify-center font-semibold transition-all rounded-xl gap-2 border-2 border-mariner-400 bg-mariner-400/10 text-mariner-200 hover:bg-mariner-400/20 hover:text-white text-base px-8 py-3"
const btnSecondary = "flex items-center justify-center font-semibold transition-all rounded-xl gap-2 border border-mariner-600 bg-transparent text-mariner-400 hover:bg-mariner-400/10 hover:text-white text-sm px-5 py-2.5"
---

<div class="flex flex-col items-center gap-3 w-full px-4 sm:px-0">
  {/* Botón primario — descarga CV */}
  <a
    href="/CV-Abraham_Vilches_de_la_Cruz.pdf"
    download="Abraham_Vilches_de_la_Cruz"
    class={btnPrimary}
  >
    <span role="img" aria-label="CV">📥</span>
    Descargar CV
  </a>

  {/* Botones secundarios en fila */}
  <div class="flex items-center gap-3">
    <a href="#projects" class={btnSecondary}>
      <span role="img" aria-label="Proyectos">🚀</span>
      Proyectos
    </a>
    <a href="https://dddominio.com" class={btnSecondary} target="_blank" rel="noopener noreferrer">
      <span role="img" aria-label="Blog">📒</span>
      Blog
    </a>
  </div>
</div>
