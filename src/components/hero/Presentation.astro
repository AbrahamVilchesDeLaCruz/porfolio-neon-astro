<div class="relative sm:border-2 sm:border-indigo-400 px-6 sm:px-8 py-2 sm:py-4 rounded-2xl sm:backdrop-blur-md flex flex-col gap-6 items-center justify-center text-center md:text-left w-full animate-fade-in h-full">
  {/* Nombre */}
  <h1 class="name-title text-4xl md:text-6xl font-light text-indigo-200 mb-1 tracking-tight w-full">
    Abraham Vilches
  </h1>

  {/* Rol */}
  <h2 class="name-title text-xl md:text-3xl font-light text-indigo-300 mb-3 tracking-wide w-full">
    Ingeniero de Software
  </h2>

  {/* Resumen profesional */}
  <p class="text-base/9 md:text-base/8 text-white/90 w-fit max-w-xs sm:max-w-fit text-center md:text-left tracking-wide">
    <span class="block mb-2">
      🧱 Diseño arquitecturas escalables que convierten complejidad técnica en productos mantenibles y preparados para crecer.
    </span>
    <span class="block mb-2">🏗️ Trabajo con DDD, microservicios y diseño estratégico para alinear decisiones técnicas con objetivos de negocio.</span>
    <span class="block">
      💼 Aporto una visión full-stack orientada a entregar software robusto, evolutivo y con impacto real en equipos y producto.
    </span>
  </p>

  {/* Tags de especialización */}
  <div class="w-full flex flex-wrap items-center gap-1.5 justify-center md:justify-start">
    {[
      "Arquitecturas",
      "DDD",
      "Microservicios",
      "React",
      "Node.js",
      "TDD",
      "Event-driven Architecture",
    ].map((tech) => (
      <span
        class="bg-indigo-800/70 text-indigo-200 px-2 py-0.5 rounded-md text-sm font-medium border border-indigo-600"
      >
        {tech}
      </span>
    ))}
  </div>
</div>
