---
import SectionTitle from './SectionTitle.astro';

const projects = [
  {
    id: 1,
    title: 'Code Finances',
    description: 'Plataforma para centralizar la gestión patrimonial y las finanzas personales, con seguimiento de inversiones, análisis de rentabilidad y una base técnica preparada para evolucionar nuevas capacidades financieras.',
    image: 'https://images.unsplash.com/photo-1563013544-824ae1b704d3',
    tech: ['React.js','Node.js','MongoDB','Tailwind','Nest.js','Jest','DDD','TDD','CI/CD','Docker','AWS'],
    github: '#',
    live: '#',
  },
  {
    id: 2,
    title: 'Ddd-code-generator',
    description: 'Paquete de NPM orientado a acelerar la creación de bounded contexts con una base alineada con DDD, Clean Architecture y estándares que reducen tiempo de arranque técnico.',
    image: 'https://github.com/npm/logos/blob/master/npm%20logo/npm-logo-red.png?raw=true',
    tech: ['Node.js', 'DDD', 'GitHub'],
    github: 'https://github.com/AbrahamVilchesDeLaCruz/bolierplate-ddd',
    live: 'https://www.npmjs.com/package/ddd-code-generator',
  },
  {
    id: 3,
    title: 'Vexel',
    description: 'Plataforma de gestión operativa para organizar personal, turnos y asignaciones mediante lógica de ordenación, mejorando la planificación y reduciendo fricción en la operación diaria.',
    image: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40',
    tech: ['React.js','MongoDB','Node.js','Docker','AWS'],
    github: '#',
    live: '#',
  },
  {
    id: 4,
    title: "DDDominio",
    description: "Plataforma de contenido técnico donde comparto aprendizajes sobre arquitectura, diseño de software y pensamiento estratégico a través del blog 'Desde La Capa De Dominio'.",
    image: '/dddominio.png',
    tech: ['Astro', 'Tailwind', 'Markdown'],
    github: '#',
    live: 'https://dddominio.com',
  },
  {
    id: 5,
    title: 'RocketShort',
    description: 'Co-fundador de rocketshort.com, una plataforma enfocada en transformar ideas y necesidades de negocio en experiencias digitales claras, rápidas de validar y listas para escalar.',
    image: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c',
    tech: ['Producto', 'Estrategia Digital', 'Full-stack'],
    github: '#',
    live: 'https://rocketshort.com',
    liveLabel: 'Visitar web',
  }
];
---

<section class="py-20">
  <div class="px-4">
    <SectionTitle title="Proyectos" />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
      {projects.map(project => (
        <div class="relative group overflow-hidden rounded-xl border border-mariner-600 hover:border-mariner-400 hover:shadow-neon transition-all duration-300 flex flex-col bg-mariner-950/40">
          {/* Imagen */}
          <div class="relative h-40 overflow-hidden border-b border-mariner-700">
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            {/* Overlay con links */}
            {(project.github !== '#' || project.live !== '#') && (
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3">
                {project.github !== '#' && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2.5 rounded-full bg-white/90 text-gray-900 hover:bg-white transition-colors"
                    aria-label="Ver repositorio en GitHub"
                  >
                    <svg fill="currentColor" viewBox="0 0 24 24" width="18" height="18"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.834 2.809 1.304 3.495.997.108-.775.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.553 3.297-1.23 3.297-1.23.653 1.653.242 2.873.119 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.803 5.624-5.475 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576 4.765-1.588 8.199-6.084 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  </a>
                )}
                {project.live !== '#' && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2.5 rounded-full bg-white/90 text-gray-900 hover:bg-white transition-colors flex items-center gap-1.5"
                    aria-label={project.liveLabel ?? 'Ver demo en vivo'}
                  >
                    <svg fill="currentColor" viewBox="0 0 24 24" width="18" height="18"><path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z"/><path d="M5 5v14h14v-7h-2v5H7V7h5V5H5z"/></svg>
                    {project.liveLabel && <span class="text-xs font-medium">{project.liveLabel}</span>}
                  </a>
                )}
              </div>
            )}
          </div>

          {/* Contenido */}
          <div class="p-5 flex flex-col gap-3 flex-grow">
            <h3 class="text-lg font-semibold text-white">{project.title}</h3>
            <p class="text-sm text-gray-400 leading-relaxed flex-grow">{project.description}</p>
            {/* Tags — máximo 4 visibles */}
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-mariner-800">
              {project.tech.slice(0, 4).map((tech) => (
                <span class="px-2 py-0.5 text-xs bg-mariner-800/60 text-mariner-300 rounded-md border border-mariner-700 font-medium">
                  {tech}
                </span>
              ))}
              {project.tech.length > 4 && (
                <span class="px-2 py-0.5 text-xs text-mariner-500 rounded-md font-medium">
                  +{project.tech.length - 4} más
                </span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
